# Copy to .env for local development. Never commit a real .env.
# Matches the PostgreSQL 16 container in compose.yaml.
DATABASE_URL=postgres://westray-papa-westray:westray-papa-westray@localhost:5432/westray-papa-westray

# The platform super admin's account id. Seeded data, such as the example themes,
# belongs to this account. Identity creates the account with this id in slice 1c.
PLATFORM_SUPER_ADMIN_ID=00000000-0000-4000-8000-000000000001

# Demonstration mode, for the separate pre-launch demo deployment only: a banner on
# every page, nothing indexed, and the invented content in data/demo/ seeded too.
# Leave false everywhere else. The launch date is YYYY-MM-DD, or empty while it is
# to be announced. Both are locked Configuration settings: only the deployment sets them.
DEMO_MODE=false
DEMO_LAUNCH_DATE=
