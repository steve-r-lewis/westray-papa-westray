# Copy to .env for local development. Never commit a real .env.
# Matches the PostgreSQL 16 container in compose.yaml.
DATABASE_URL=postgres://westray-papa-westray:westray-papa-westray@localhost:5432/westray-papa-westray

# The same database as the runtime role Identity and Profile serve requests as: a role
# of its own that owns nothing and cannot bypass row-level security. The site and
# `pnpm db:seed` create it, as DATABASE_URL's role, with this name and password (a
# plain lower-case identifier, as Identity and Profile require).
DATABASE_RUNTIME_URL=postgres://westray_runtime:westray_runtime@localhost:5432/westray-papa-westray

# The provisioning request (a UUIDv7) by which `pnpm db:seed` has Identity issue the
# platform super admin. Identity issues the super admin's identity id itself; the seed
# records it, and seeded data, such as the example themes, belongs to it. Fixed once seeded.
PLATFORM_SUPER_ADMIN_ID=01900000-0000-7000-8000-000000000001

# Authentication's signing and encryption secret: at least 32 random bytes. This one is
# for local development only; every deployment has its own, from its secret store.
NUXT_AUTHENTICATION_SECRET=Ep3LPijHg-gTb56TJfrYQhHDOWTTuw2TpPuQ9vEYKlg

# The site's public origin, which every IAM layer checks state-changing requests
# against (https everywhere but on this machine).
NUXT_AUTHENTICATION_BASE_URL=http://localhost:3000
NUXT_IDENTITY_BASE_URL=http://localhost:3000
NUXT_PROFILE_BASE_URL=http://localhost:3000
NUXT_AUTHORISATION_BASE_URL=http://localhost:3000

# Profile's master keys, which wrap each person's own data key: version=key pairs,
# each key 32 random bytes in base64, and the version new keys are wrapped with. This
# one is for local development only.
PROFILE_KEYS=dev-1=b64QfbdgoEEdv52N3aqHNUBqw/3xKNRO7wD03YO2f1U=
PROFILE_KEY_VERSION=dev-1

# How the site's email (verification links, password resets, security notices) leaves:
# `directory` writes each message as a file in MAIL_DIRECTORY, for this machine and the
# tests; `smtp` sends it through SMTP_URL (smtps://user:password@host:465) from MAIL_FROM.
MAIL_TRANSPORT=directory
MAIL_DIRECTORY=.mail
MAIL_FROM=
SMTP_URL=

# Demonstration mode, for the separate pre-launch demo deployment only: a banner on
# every page, nothing indexed, and the invented content in data/demo/ seeded too.
# Leave false everywhere else. The launch date is YYYY-MM-DD, or empty while it is
# to be announced. Both are locked Configuration settings: only the deployment sets them.
DEMO_MODE=false
DEMO_LAUNCH_DATE=
